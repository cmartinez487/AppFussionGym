# ==========================================================
#  Plantilla de variables de entorno
#  Copia este archivo a ".env" y cambia los valores reales:
#      cp .env.example .env
# ==========================================================

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=gymdb
POSTGRES_USER=gym
POSTGRES_PASSWORD=cambia_esta_password

# --- Autenticación / login (JWT) ---
# La clave debe tener al menos 32 caracteres
JWT_KEY=cambia_esta_clave_jwt_minimo_32_caracteres
JWT_ISSUER=AppFussionGym
JWT_AUDIENCE=AppFussionGym

# --- Usuario administrador (se crea en el seed) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_password
